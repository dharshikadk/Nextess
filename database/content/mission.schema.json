{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Nextess Mission Content Package",
  "type":"object",
  "required":["contentPackageVersion","projects"],
  "properties":{
    "contentPackageVersion":{"type":"integer","minimum":1},
    "projects":{
      "type":"array","items":{"$ref":"#/$defs/project"}
    }
  },
  "$defs":{
    "project":{
      "type":"object",
      "required":["key","subject","version","title","mission","levels"],
      "properties":{
        "key":{"type":"string","minLength":1},
        "subject":{"type":"string","minLength":1},
        "version":{"type":"integer","minimum":1},
        "title":{"type":"string","minLength":1},
        "difficulty":{"type":"string"},
        "estimatedLength":{"type":"string"},
        "problemType":{"type":"string"},
        "role":{"type":"string"},
        "mission":{"type":"string","minLength":1},
        "learningCapsule":{"type":"object"},
        "stages":{"type":"array"},
        "levels":{"type":"array","items":{"$ref":"#/$defs/level"}},
        "requiredEvidence":{"type":"object"},
        "requiredSimulation":{"type":"object"}
      }
    },
    "level":{
      "type":"object",
      "required":["number","title","questions"],
      "properties":{
        "number":{"type":"integer","minimum":1},
        "title":{"type":"string","minLength":1},
        "questions":{"type":"array","items":{"$ref":"#/$defs/question"}},
        "evidenceUse":{"type":"string"},
        "simulationUse":{"type":"string"}
      }
    },
    "question":{
      "type":"object",
      "required":["number","type","prompt"],
      "properties":{
        "number":{"type":"integer","minimum":1},
        "type":{"type":"string","minLength":1},
        "prompt":{"type":"string","minLength":1},
        "options":{"type":"array","items":{"type":"string"}},
        "answer":{},
        "unit":{"type":"string"},
        "tolerance":{"type":"number","minimum":0},
        "hints":{"type":"array","items":{"type":"string"}},
        "explanation":{"type":"string"}
      }
    }
  }
}