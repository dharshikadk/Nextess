{
  "name": "nextess-database",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "generate": "prisma generate",
    "validate": "node scripts/require-database-url.mjs && prisma validate",
    "format": "prisma format",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "node scripts/require-database-url.mjs && prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:v2": "tsx prisma/seed-v2.ts",
    "mission:validate": "tsx src/mission-cli.ts validate",
    "mission:import": "tsx src/mission-cli.ts import",
    "mission:publish": "tsx src/mission-cli.ts publish",
    "test": "tsx src/*.test.ts",
    "migrate:docker": "docker compose -f ../docker-compose.dev.yml run --rm backend npm run prisma:migrate",
    "setup:docker": "docker compose -f ../docker-compose.dev.yml up -d postgres && docker compose -f ../docker-compose.dev.yml run --rm backend npm run prisma:migrate",
    "seed:docker": "docker compose -f ../docker-compose.dev.yml run --rm backend npm --prefix ../database run seed",
    "reconcile:rewards": "tsx src/maintenance.ts reconcile-rewards",
    "cleanup:anonymous": "tsx src/maintenance.ts cleanup-anonymous"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
