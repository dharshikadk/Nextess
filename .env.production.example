# Vercel production configuration template. Store actual values in Vercel Environment Variables.
# DATABASE_URL must point to your managed PostgreSQL provider; do not use the local Docker hostname.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Set this to the production/custom frontend URL. Vercel preview URLs are accepted automatically.
FRONTEND_ORIGIN=https://YOUR-NEXTESS-DOMAIN
SESSION_DAYS=30
TRUST_PROXY=true
# VITE_API_BASE_URL is intentionally omitted: production frontend calls same-origin /v1/* paths routed by Vercel Services.
