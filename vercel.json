{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend-v2",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "installCommand": "cd ../database && npm install --production=false && cd ../backend && npm install --production=false",
      "buildCommand": "npm run vercel-build",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/ready",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
