{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend-v2",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "node",
      "entrypoint": "src/server.ts",
      "installCommand": "npm install",
      "buildCommand": "npm install --package-lock-only --ignore-scripts && npm ci && npm run vercel-build"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/ready",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
