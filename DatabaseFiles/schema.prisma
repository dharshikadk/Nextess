// ============================================================================
// NEXTESS — Prisma schema
// This file is a 1:1 mapping of /sql/001_schema.sql, which has already been
// applied to and validated against a live PostgreSQL 16 instance (see
// /VALIDATION_REPORT.md for exactly what was run and what it proved).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum SubjectStatus {
  AVAILABLE
  COMING_SOON
  DISABLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  HARDEST
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MissionFileType {
  REPORT
  DATA_TABLE
  OBSERVATION
  ENGINEERING_REPORT
  ECONOMIC_REPORT
  GRAPH
  REFERENCE
  CONCEPT_BRIEF
}

enum QuestionType {
  CONCEPT_IDENTIFICATION
  INVESTIGATION
  NUMERICAL
  PREDICTION
  WHAT_IF
  ANALYSIS
  DECISION
  ENGINEERING_DESIGN
}

enum ValueDataType {
  NUMBER
  INTEGER
  BOOLEAN
  TEXT
  ENUM
}

enum RewardType {
  XP
  COINS
  BADGE
}

enum RewardSource {
  QUESTION_CORRECT
  HINT_UNLOCK_COST
  LEVEL_COMPLETION
  MISSION_COMPLETION
  STREAK_BONUS
  BADGE_AWARD
  MANUAL_ADJUSTMENT
  ACCOUNT_MIGRATION
}

enum ActivityType {
  MISSION_STARTED
  LEVEL_STARTED
  QUESTION_ANSWERED
  LEVEL_COMPLETED
  MISSION_COMPLETED
  SIMULATION_RUN
}

enum EventType {
  PROJECT_OPENED
  MISSION_STARTED
  LEVEL_STARTED
  QUESTION_VIEWED
  ANSWER_SUBMITTED
  ANSWER_CORRECT
  ANSWER_INCORRECT
  HINT_USED
  ANSWER_REVEALED
  SIMULATION_CHANGED
  LEVEL_COMPLETED
  MISSION_COMPLETED
  ACCOUNT_CREATED
  THEME_CHANGED
  FEEDBACK_SUBMITTED
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  CONTENT_ISSUE
  GENERAL
  PRAISE
}

// ---------------------------------------------------------------------------
// LOOKUP / REFERENCE TABLES
// ---------------------------------------------------------------------------

model ConsequenceDefinition {
  code        String   @id @db.VarChar(64)
  label       String   @db.VarChar(160)
  description String?
  severity    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  simulationRules SimulationRule[]
  simulationStates UserSimulationState[]

  @@map("consequence_definition")
}

model MissionProblemType {
  code        String   @id @db.VarChar(64)
  label       String   @db.VarChar(160)
  description String?
  subjectHint String?  @map("subject_hint") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")

  missions Mission[]

  @@map("mission_problem_type")
}

// Controlled, extensible vocabulary of simulation categories (Physics
// interactive model, Economics graph model, Chemistry reaction lab, ...).
// New subject simulation styles are added as ROWS here, never as a new
// table/model. See MISSION_CONTENT_SPEC.md.
model SimulationType {
  code        String   @id @db.VarChar(64)
  label       String   @db.VarChar(160)
  description String?
  subjectHint String?  @map("subject_hint") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")

  simulations Simulation[]

  @@map("simulation_type")
}

// ---------------------------------------------------------------------------
// AUTHENTICATION & IDENTITY
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  username        String    @unique @db.Citext
  email           String    @unique @db.Citext
  grade           String?   @db.VarChar(32)
  level           Int       @default(1)
  xp              Int       @default(0)
  coins           Int       @default(0)
  currentStreak   Int       @default(0) @map("current_streak")
  longestStreak   Int       @default(0) @map("longest_streak")
  lastActivityAt  DateTime? @map("last_activity_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  credential            UserCredential?
  sessions              UserSession[]
  setting               UserSetting?
  missionProgress       UserMissionProgress[]
  levelProgress         UserLevelProgress[]
  questionProgress      UserQuestionProgress[]
  responses             UserResponse[]
  hintUsages            HintUsage[]
  levelCompletions      LevelCompletion[]
  activities            UserActivity[]
  streakDays            StreakDay[]
  rewardTransactions    RewardTransaction[]
  badges                UserBadge[]
  eventLogs             EventLog[]
  conceptPerformance    ConceptPerformance[]
  mistakeRecords        MistakeRecord[]
  performanceSnapshots  UserPerformanceSnapshot[]
  feedback              Feedback[]
  simulationStates      UserSimulationState[]
  convertedFromSessions AnonymousSession[]        @relation("ConvertedUser")

  @@map("app_user")
}

model UserCredential {
  userId             String    @id @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  passwordAlgo       String    @default("argon2id") @map("password_algo") @db.VarChar(32)
  passwordUpdatedAt  DateTime  @default(now()) @map("password_updated_at")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credential")
}

model AnonymousSession {
  id                 String    @id @default(uuid()) @db.Uuid
  sessionTokenHash   String    @unique @map("session_token_hash") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")
  lastActiveAt       DateTime  @default(now()) @map("last_active_at")
  expiresAt          DateTime  @map("expires_at")
  convertedToUserId  String?   @map("converted_to_user_id") @db.Uuid
  convertedAt        DateTime? @map("converted_at")

  convertedToUser User? @relation("ConvertedUser", fields: [convertedToUserId], references: [id], onDelete: SetNull)
  setting          AnonymousSetting?

  missionProgress     UserMissionProgress[]
  levelProgress       UserLevelProgress[]
  questionProgress    UserQuestionProgress[]
  responses           UserResponse[]
  hintUsages          HintUsage[]
  levelCompletions    LevelCompletion[]
  activities          UserActivity[]
  streakDays          StreakDay[]
  rewardTransactions  RewardTransaction[]
  badges              UserBadge[]
  eventLogs           EventLog[]
  conceptPerformance  ConceptPerformance[]
  mistakeRecords      MistakeRecord[]
  feedback            Feedback[]
  simulationStates    UserSimulationState[]

  @@map("anonymous_session")
}

model UserSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.VarChar(255)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}

model UserSetting {
  userId    String          @id @map("user_id") @db.Uuid
  theme     ThemePreference @default(SYSTEM)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_setting")
}

model AnonymousSetting {
  anonymousSessionId String          @id @map("anonymous_session_id") @db.Uuid
  theme              ThemePreference @default(SYSTEM)
  updatedAt          DateTime        @updatedAt @map("updated_at")

  anonymousSession AnonymousSession @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  @@map("anonymous_setting")
}

// ---------------------------------------------------------------------------
// CONTENT DOMAIN
// ---------------------------------------------------------------------------

model Subject {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(32)
  name         String        @db.VarChar(120)
  description  String?
  status       SubjectStatus @default(COMING_SOON)
  displayOrder Int           @default(0) @map("display_order")
  icon         String?       @db.VarChar(64)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  concepts Concept[]
  missions Mission[]

  @@map("subject")
}

model Concept {
  id          String  @id @default(uuid()) @db.Uuid
  subjectId   String  @map("subject_id") @db.Uuid
  code        String  @db.VarChar(64)
  name        String  @db.VarChar(160)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  subject             Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questionConcepts     QuestionConcept[]
  conceptPerformance   ConceptPerformance[]
  mistakeRecords       MistakeRecord[]

  @@unique([subjectId, code])
  @@map("concept")
}

model Mission {
  id                       String          @id @default(uuid()) @db.Uuid
  subjectId                String          @map("subject_id") @db.Uuid
  slug                     String          @db.VarChar(120)
  version                  Int             @default(1)
  isCurrent                Boolean         @default(true) @map("is_current")
  title                    String          @db.VarChar(200)
  difficulty               DifficultyLevel @default(EASY)
  description              String?
  missionBrief             String?         @map("mission_brief")
  role                     String?         @db.VarChar(160)
  priority                 String?         @db.VarChar(64)
  problemTypeCode          String?         @map("problem_type_code") @db.VarChar(64)
  estimatedLengthMinutes   Int?            @map("estimated_length_minutes")
  xpReward                 Int             @default(0) @map("xp_reward")
  coinReward               Int             @default(0) @map("coin_reward")
  status                   ContentStatus   @default(DRAFT)
  previousVersionId        String?         @map("previous_version_id") @db.Uuid
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  subject       Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  problemType   MissionProblemType?  @relation(fields: [problemTypeCode], references: [code])
  previousVersion Mission?           @relation("MissionVersionChain", fields: [previousVersionId], references: [id])
  nextVersions    Mission[]         @relation("MissionVersionChain")

  case         MissionCase?
  levels       Level[]
  files        MissionFile[]
  simulations  Simulation[]
  progress     UserMissionProgress[]

  @@unique([slug, version])
  @@map("mission")
}

model MissionCase {
  id          String  @id @default(uuid()) @db.Uuid
  missionId   String  @unique @map("mission_id") @db.Uuid
  title       String  @db.VarChar(200)
  situation   String
  background  String?
  constraints String?
  objective   String?
  extra       Json?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@map("mission_case")
}

model Level {
  id                  String        @id @default(uuid()) @db.Uuid
  missionId           String        @map("mission_id") @db.Uuid
  levelNumber         Int           @map("level_number")
  slug                String        @db.VarChar(120)
  version             Int           @default(1)
  isCurrent           Boolean       @default(true) @map("is_current")
  title               String        @db.VarChar(200)
  description         String?
  objective           String
  xpReward            Int           @default(0) @map("xp_reward")
  coinReward          Int           @default(0) @map("coin_reward")
  completionSummary   String?       @map("completion_summary")
  conceptsApplied     String?       @map("concepts_applied")
  status              ContentStatus @default(DRAFT)
  previousVersionId   String?       @map("previous_version_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  mission          Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  previousVersion  Level?               @relation("LevelVersionChain", fields: [previousVersionId], references: [id])
  nextVersions     Level[]              @relation("LevelVersionChain")

  questions        Question[]
  files            MissionFile[]
  simulations      Simulation[]
  progress         UserLevelProgress[]
  completions      LevelCompletion[]

  @@unique([missionId, levelNumber, version])
  @@map("level")
}

model Question {
  id                  String        @id @default(uuid()) @db.Uuid
  levelId             String        @map("level_id") @db.Uuid
  questionNumber      Int           @map("question_number")
  slug                String        @db.VarChar(120)
  version             Int           @default(1)
  isCurrent           Boolean       @default(true) @map("is_current")
  questionType        QuestionType  @map("question_type")
  prompt              String
  instruction         String?
  difficulty          DifficultyLevel @default(EASY)
  answerDataType      ValueDataType @default(TEXT) @map("answer_data_type")
  hintCostXp          Int           @default(10) @map("hint_cost_xp")
  maxAttempts         Int?          @map("max_attempts")
  xpReward            Int           @default(0) @map("xp_reward")
  coinReward          Int           @default(0) @map("coin_reward")
  displayOrder        Int           @default(0) @map("display_order")
  status              ContentStatus @default(DRAFT)
  previousVersionId   String?       @map("previous_version_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  level           Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  previousVersion Question? @relation("QuestionVersionChain", fields: [previousVersionId], references: [id])
  nextVersions    Question[] @relation("QuestionVersionChain")

  answerKey       QuestionAnswerKey?
  options         QuestionOption[]
  hints           Hint[]
  explanation     AnswerExplanation?
  concepts        QuestionConcept[]
  progress        UserQuestionProgress[]
  responses       UserResponse[]
  hintUsages      HintUsage[]
  mistakeRecords  MistakeRecord[]

  @@unique([levelId, questionNumber, version])
  @@map("question")
}

model QuestionAnswerKey {
  questionId       String  @id @map("question_id") @db.Uuid
  correctValue     String? @map("correct_value")
  tolerance        Decimal? @db.Decimal
  evaluationRules  Json?   @map("evaluation_rules")
  updatedAt        DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_answer_key")
}

model QuestionOption {
  id            String @id @default(uuid()) @db.Uuid
  questionId    String @map("question_id") @db.Uuid
  optionText    String @map("option_text")
  optionValue   String @map("option_value") @db.VarChar(64)
  displayOrder  Int    @default(0) @map("display_order")

  question    Question                     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  correctness QuestionOptionCorrectness?

  @@unique([questionId, optionValue])
  @@map("question_option")
}

model QuestionOptionCorrectness {
  questionOptionId String  @id @map("question_option_id") @db.Uuid
  isCorrect        Boolean @default(false) @map("is_correct")

  option QuestionOption @relation(fields: [questionOptionId], references: [id], onDelete: Cascade)

  @@map("question_option_correctness")
}

model Hint {
  id            String @id @default(uuid()) @db.Uuid
  questionId    String @map("question_id") @db.Uuid
  hintNumber    Int    @map("hint_number")
  content       String
  costXp        Int    @default(10) @map("cost_xp")
  displayOrder  Int    @default(0) @map("display_order")

  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  usages   HintUsage[]

  @@unique([questionId, hintNumber])
  @@map("hint")
}

model AnswerExplanation {
  questionId                String   @id @map("question_id") @db.Uuid
  overview                  String
  reasoning                 String
  conceptsUsed              String?  @map("concepts_used")
  calculation               String?
  finalResult               String?  @map("final_result")
  simulationInterpretation  String?  @map("simulation_interpretation")
  engineeringMeaning        String?  @map("engineering_meaning")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answer_explanation")
}

model QuestionConcept {
  questionId String @map("question_id") @db.Uuid
  conceptId  String @map("concept_id") @db.Uuid

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([questionId, conceptId])
  @@map("question_concept")
}

model MissionFile {
  id                String          @id @default(uuid()) @db.Uuid
  missionId         String          @map("mission_id") @db.Uuid
  levelId           String?         @map("level_id") @db.Uuid
  slug              String          @db.VarChar(120)
  version           Int             @default(1)
  isCurrent         Boolean         @default(true) @map("is_current")
  name              String          @db.VarChar(200)
  fileType          MissionFileType @map("file_type")
  description       String?
  displayOrder      Int             @default(0) @map("display_order")
  content           Json
  storageObjectKey  String?         @map("storage_object_key") @db.VarChar(500)
  status            ContentStatus   @default(DRAFT)
  createdAt         DateTime        @default(now()) @map("created_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([missionId, slug, version])
  @@map("mission_file")
}

// ---------------------------------------------------------------------------
// PHYSICS SIMULATION DOMAIN
// ---------------------------------------------------------------------------

model Simulation {
  id            String        @id @default(uuid()) @db.Uuid
  missionId     String        @map("mission_id") @db.Uuid
  levelId       String        @map("level_id") @db.Uuid
  slug          String        @db.VarChar(120)
  version       Int           @default(1)
  isCurrent     Boolean       @default(true) @map("is_current")
  title         String        @db.VarChar(200)
  description   String?
  engine        String        @db.VarChar(64)
  typeCode      String?       @map("type_code") @db.VarChar(64)
  configuration Json          @default("{}")
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")

  mission   Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  level     Level                @relation(fields: [levelId], references: [id], onDelete: Cascade)
  type      SimulationType?      @relation(fields: [typeCode], references: [code])
  variables SimulationVariable[]
  rules     SimulationRule[]
  states    UserSimulationState[]

  @@unique([missionId, slug, version])
  @@map("simulation")
}

model SimulationVariable {
  id             String        @id @default(uuid()) @db.Uuid
  simulationId   String        @map("simulation_id") @db.Uuid
  name           String        @db.VarChar(80)
  label          String        @db.VarChar(160)
  unit           String?       @db.VarChar(32)
  dataType       ValueDataType @default(NUMBER) @map("data_type")
  minimum        Decimal?      @db.Decimal
  maximum        Decimal?      @db.Decimal
  step           Decimal?      @db.Decimal
  defaultValue   Decimal?      @map("default_value") @db.Decimal
  displayOrder   Int           @default(0) @map("display_order")

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, name])
  @@map("simulation_variable")
}

model SimulationRule {
  id                String @id @default(uuid()) @db.Uuid
  simulationId      String @map("simulation_id") @db.Uuid
  priority          Int    @default(0)
  conditions        Json
  consequenceCode   String @map("consequence_code") @db.VarChar(64)
  messageKey        String? @map("message_key") @db.VarChar(160)

  simulation  Simulation             @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  consequence ConsequenceDefinition  @relation(fields: [consequenceCode], references: [code])

  @@unique([simulationId, priority])
  @@map("simulation_rule")
}

// Generic per-actor simulation runtime state (controller values, last
// consequence reached, etc.), separate from the authored `configuration`
// and from a submitted `UserResponse.answer`. One row per (actor,
// simulation); same subject-agnostic mechanism serves every subject's
// simulation style. See MISSION_CONTENT_SPEC.md.
model UserSimulationState {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  anonymousSessionId  String?   @map("anonymous_session_id") @db.Uuid
  simulationId        String    @map("simulation_id") @db.Uuid
  state               Json      @default("{}")
  lastConsequenceCode String?   @map("last_consequence_code") @db.VarChar(64)
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user              User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession  AnonymousSession?      @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  simulation        Simulation             @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  lastConsequence   ConsequenceDefinition? @relation(fields: [lastConsequenceCode], references: [code])

  @@map("user_simulation_state")
}

// ---------------------------------------------------------------------------
// LEARNING PROGRESS
// ---------------------------------------------------------------------------

model UserMissionProgress {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String?        @map("user_id") @db.Uuid
  anonymousSessionId  String?        @map("anonymous_session_id") @db.Uuid
  missionId           String         @map("mission_id") @db.Uuid
  currentLevelId      String?        @map("current_level_id") @db.Uuid
  currentQuestionId   String?        @map("current_question_id") @db.Uuid
  status              ProgressStatus @default(NOT_STARTED)
  startedAt           DateTime       @default(now()) @map("started_at")
  lastAccessedAt      DateTime       @default(now()) @map("last_accessed_at")
  completedAt         DateTime?      @map("completed_at")

  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession  AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  mission           Mission           @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@map("user_mission_progress")
}

model UserLevelProgress {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String?        @map("user_id") @db.Uuid
  anonymousSessionId  String?        @map("anonymous_session_id") @db.Uuid
  levelId             String         @map("level_id") @db.Uuid
  status              ProgressStatus @default(NOT_STARTED)
  currentQuestion     Int            @default(0) @map("current_question")
  questionsCompleted  Int            @default(0) @map("questions_completed")
  xpEarned            Int            @default(0) @map("xp_earned")
  coinsEarned         Int            @default(0) @map("coins_earned")
  startedAt           DateTime       @default(now()) @map("started_at")
  completedAt         DateTime?      @map("completed_at")

  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession  AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  level             Level             @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@map("user_level_progress")
}

model UserQuestionProgress {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String?        @map("user_id") @db.Uuid
  anonymousSessionId  String?        @map("anonymous_session_id") @db.Uuid
  questionId          String         @map("question_id") @db.Uuid
  status              ProgressStatus @default(NOT_STARTED)
  attemptCount        Int            @default(0) @map("attempt_count")
  hintUsedCount       Int            @default(0) @map("hint_used_count")
  answerRevealed      Boolean        @default(false) @map("answer_revealed")
  solvedAt            DateTime?      @map("solved_at")

  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession  AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  question          Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@map("user_question_progress")
}

model UserResponse {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  anonymousSessionId  String?   @map("anonymous_session_id") @db.Uuid
  questionId          String    @map("question_id") @db.Uuid
  attemptNumber       Int       @map("attempt_number")
  answer              Json
  isCorrect           Boolean   @map("is_correct")
  score               Decimal?  @db.Decimal
  xpAwarded           Int       @default(0) @map("xp_awarded")
  coinsAwarded        Int       @default(0) @map("coins_awarded")
  hintUsed            Boolean   @default(false) @map("hint_used")
  submittedAt         DateTime  @default(now()) @map("submitted_at")

  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession  AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  question          Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@map("user_response")
}

