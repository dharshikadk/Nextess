model RewardTransaction {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String?      @map("user_id") @db.Uuid
  anonymousSessionId  String?      @map("anonymous_session_id") @db.Uuid
  type                RewardType
  amount              Int
  source              RewardSource
  referenceId         String?      @map("reference_id") @db.Uuid
  idempotencyKey      String       @unique @map("idempotency_key") @db.VarChar(200)
  createdAt           DateTime     @default(now()) @map("created_at")

  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession  AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)

  @@map("reward_transaction")
}

model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(160)
  description String?
  icon        String?  @db.VarChar(64)
  criteria    Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badge")
}

model UserBadge {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String?  @map("user_id") @db.Uuid
  anonymousSessionId  String?  @map("anonymous_session_id") @db.Uuid
  badgeId             String   @map("badge_id") @db.Uuid
  earnedAt            DateTime @default(now()) @map("earned_at")
  metadata            Json?

  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession  AnonymousSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: Cascade)
  badge             Badge             @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@map("user_badge")
}

