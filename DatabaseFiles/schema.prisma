model UserPerformanceSnapshot {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  computedAt                DateTime @default(now()) @map("computed_at")
  totalQuestionsAnswered    Int      @default(0) @map("total_questions_answered")
  accuracyRate              Decimal? @map("accuracy_rate") @db.Decimal(5, 4)
  avgAttemptsPerQuestion    Decimal? @map("avg_attempts_per_question") @db.Decimal(6, 2)
  totalHintsUsed            Int      @default(0) @map("total_hints_used")
  missionsCompleted         Int      @default(0) @map("missions_completed")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_performance_snapshot")
}

